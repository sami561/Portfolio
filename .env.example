# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Anthropic (AI chat widget: app/api/chat/route.ts) ---
# Get a key at https://console.anthropic.com/settings/keys
# If unset, the chat endpoint responds 503 "Chat is not configured".
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SMTP (contact form: lib/mail.ts) ---
# Gmail: use an App Password, not your account password.
# https://myaccount.google.com/apppasswords
# WARNING: the NEXT_PUBLIC_ prefix exposes these to the browser bundle.
# See the note in README — these should be renamed to SMTP_EMAIL / SMTP_PASSWORD.
NEXT_PUBLIC_SMTP_EMAIL=you@example.com
NEXT_PUBLIC_SMTP_PASSWORD=your-app-password
